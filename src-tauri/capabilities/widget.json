{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget",
  "description": "Capability for the desktop widget window (T06)",
  "windows": ["widget"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "log:default"
  ]
}
